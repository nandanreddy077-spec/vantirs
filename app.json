{
  "name": "FocusFlowApp",
  "displayName": "Focus Flow",
  "version": "1.0.0",
  "description": "AI-powered distraction management app with gamification features",
  "author": "Focus Flow Team",
  "license": "MIT",
  "expo": {
    "name": "Focus Flow",
    "slug": "focus-flow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "splash": {
      "image": "./src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C5CE7"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.focusflow.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#6C5CE7"
      },
      "package": "com.focusflow.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
