# ============================================
# VANTIRS PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy these to Vercel → Settings → Environment Variables
# Make sure to select "Production" environment

# ============================================
# STRIPE (PRODUCTION - LIVE MODE)
# ============================================
# ⚠️ Switch Stripe Dashboard to LIVE MODE first!
# Create restricted key: Developers → API keys → Create restricted key
# Permissions: charges:read, disputes:read, disputes:write
STRIPE_SECRET_KEY=rk_live_YOUR_PRODUCTION_RESTRICTED_KEY_HERE

# Create webhook: Developers → Webhooks → Add endpoint
# URL: https://vantirs.com/api/webhooks/stripe
# Event: charge.dispute.created
STRIPE_WEBHOOK_SECRET=whsec_YOUR_PRODUCTION_WEBHOOK_SECRET_HERE

# Get from: API keys → Publishable key (Live mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY_HERE

# ============================================
# SUPABASE (PRODUCTION)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://wsmthoimcnlxebvxhisp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# APP CONFIGURATION (PRODUCTION)
# ============================================
NEXT_PUBLIC_APP_URL=https://vantirs.com
NEXT_PUBLIC_SHIELDRATE_ENABLED=true

# ============================================
# RATE LIMITING (OPTIONAL but recommended)
# ============================================
# Create at: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ============================================
# CRON SECURITY (OPTIONAL)
# ============================================
# Generate random secret for cron endpoint
CRON_SECRET=your-random-secret-key-here

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
NODE_ENV=production
